{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auram",
  "version": "0.0.0",
  "identifier": "art.arcane.auram.auramLauncher",
  "build": {
    "beforeDevCommand": "pnpm frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm frontend:build && node scripts/package-game-helper.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Auram",
        "width": 1100,
        "height": 760,
        "minWidth": 850,
        "minHeight": 650,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": {
        "Helpers/Auram.app": "../.build/mac-game-helper/Auram.app"
      },
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4OUZBNkNGMjgwRDkyNjEKUldSaGtnMG96NmFmMk1BSHdZb21SWHI2NldUMzZRM3BKTFRseUFIZEp1TW9HR1djRmlnbEx0ckwK",
      "endpoints": [
        "https://github.com/AuramMods/auram_launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
